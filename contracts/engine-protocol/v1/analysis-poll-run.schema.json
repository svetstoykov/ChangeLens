{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changelens.dev/contracts/engine-protocol/v1/analysis-poll-run.schema.json",
  "title": "ChangeLens analysis-poll-run exchange",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/pollResult" },
    { "$ref": "https://changelens.dev/contracts/engine-protocol/v1/error-response.schema.json" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "action", "parameters"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "action": { "const": "analysis.pollRun" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runId"],
          "properties": { "runId": { "$ref": "#/$defs/runId" } }
        }
      }
    },
    "pollResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "requestId", "result"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "result" },
        "requestId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "result": { "$ref": "#/$defs/runSummary" }
      }
    },
    "runSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "state", "repository", "comparison", "requestedAt", "captureStartedAt", "capturedAt", "snapshotId", "cancellationRequested", "facts", "terminal", "interruptedAt", "interruptionReason", "readingModel", "validationRemovals"],
      "properties": {
        "runId": { "$ref": "#/$defs/runId" },
        "state": { "enum": ["pendingCapture", "capturing", "discovering", "collecting", "persisting", "completed", "completedWithLimitations", "cancelled", "failed", "interrupted"] },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositoryId", "displayName", "canonicalPath", "head"],
          "properties": {
            "repositoryId": { "$ref": "#/$defs/guid" },
            "displayName": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "canonicalPath": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "head": { "$ref": "#/$defs/revision" }
          }
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "targetRevision", "freshnessToken"],
          "properties": {
            "target": { "$ref": "#/$defs/refName" },
            "targetRevision": { "$ref": "#/$defs/revision" },
            "freshnessToken": { "$ref": "#/$defs/token" }
          }
        },
        "requestedAt": { "$ref": "#/$defs/timestamp" },
        "captureStartedAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "capturedAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "snapshotId": { "anyOf": [{ "$ref": "#/$defs/guid" }, { "type": "null" }] },
        "cancellationRequested": { "type": "boolean" },
        "facts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "count", "detail"],
            "properties": {
              "kind": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S" },
              "count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
              "detail": { "type": ["string", "null"], "maxLength": 512 }
            }
          }
        },
        "terminal": { "anyOf": [{ "$ref": "#/$defs/terminal" }, { "type": "null" }] },
        "interruptedAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "interruptionReason": { "enum": ["engineStopped", null] },
        "readingModel": { "anyOf": [{ "$ref": "#/$defs/readingModel" }, { "type": "null" }] },
        "validationRemovals": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/$defs/validationRemoval" } },
            { "type": "null" }
          ]
        }
      }
    },
    "readingModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thesis", "areas", "citations", "evidence", "limitations", "omissionSummaries", "assurances"],
      "properties": {
        "thesis": { "anyOf": [{ "$ref": "#/$defs/statement" }, { "type": "null" }] },
        "areas": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/area" } },
        "citations": { "type": "array", "maxItems": 4000, "items": { "$ref": "#/$defs/citation" } },
        "evidence": { "type": "array", "maxItems": 120, "items": { "$ref": "#/$defs/evidence" } },
        "limitations": { "type": "array", "items": { "$ref": "#/$defs/limitation" } },
        "omissionSummaries": { "type": "array", "items": { "$ref": "#/$defs/omissionSummary" } },
        "assurances": { "type": "array", "items": { "$ref": "#/$defs/assurance" } }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "shape", "participants", "relationships", "orderedSteps", "purposes"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string" },
        "summary": { "anyOf": [{ "$ref": "#/$defs/statement" }, { "type": "null" }] },
        "shape": { "enum": ["walk", "participantMap", "purposeCards", "participantList"] },
        "participants": { "type": "array", "items": { "$ref": "#/$defs/participant" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
        "orderedSteps": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
        "purposes": { "type": "array", "items": { "$ref": "#/$defs/statement" } }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "text", "trust", "evidenceNodeIds"],
      "properties": {
        "claimId": { "$ref": "#/$defs/identifier" },
        "text": { "type": "string", "maxLength": 1000 },
        "trust": { "$ref": "#/$defs/trust" },
        "evidenceNodeIds": { "$ref": "#/$defs/nodeIds" }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role", "changed", "evidenceNodeIds"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "changed": { "type": "boolean" },
        "evidenceNodeIds": { "$ref": "#/$defs/nodeIds" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "id", "fromParticipantId", "toParticipantId", "kind", "explanation", "trust", "evidenceNodeIds"],
      "properties": {
        "claimId": { "$ref": "#/$defs/identifier" },
        "id": { "$ref": "#/$defs/identifier" },
        "fromParticipantId": { "$ref": "#/$defs/identifier" },
        "toParticipantId": { "$ref": "#/$defs/identifier" },
        "kind": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "explanation": { "type": "string", "maxLength": 1000 },
        "trust": { "$ref": "#/$defs/trust" },
        "evidenceNodeIds": { "$ref": "#/$defs/nodeIds" }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "nodeId", "side", "path", "objectId", "startLine", "endLine", "focus", "provenance"],
      "properties": {
        "claimId": { "$ref": "#/$defs/identifier" },
        "nodeId": { "$ref": "#/$defs/identifier" },
        "side": { "$ref": "#/$defs/side" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "objectId": { "$ref": "#/$defs/revision" },
        "startLine": { "$ref": "#/$defs/line" },
        "endLine": { "$ref": "#/$defs/line" },
        "focus": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodeId", "startLine", "endLine"],
            "properties": {
              "nodeId": { "$ref": "#/$defs/identifier" },
              "startLine": { "$ref": "#/$defs/line" },
              "endLine": { "$ref": "#/$defs/line" }
            }
          }
        },
        "provenance": { "$ref": "#/$defs/trust" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "path", "side", "startLine", "endLine", "isChangedFile", "isRedacted", "isTruncated", "text"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "side": { "$ref": "#/$defs/side" },
        "startLine": { "$ref": "#/$defs/line" },
        "endLine": { "$ref": "#/$defs/line" },
        "isChangedFile": { "type": "boolean" },
        "isRedacted": { "type": "boolean" },
        "isTruncated": { "type": "boolean" },
        "text": { "type": "string", "maxLength": 8000 }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "detail"],
      "properties": {
        "kind": { "enum": ["fileNotRead", "fileNotQuoted", "uncommittedWorkExcluded"] },
        "path": { "anyOf": [{ "$ref": "#/$defs/repositoryPath" }, { "type": "null" }] },
        "detail": { "type": "string" }
      }
    },
    "omissionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind", "reason", "totalCount", "sampleCount", "resolvedSampleCount"],
      "properties": {
        "sourceKind": { "enum": ["fileNotRead", "noEvidenceSelected", "policyExcluded"] },
        "reason": { "type": "string" },
        "totalCount": { "$ref": "#/$defs/count" },
        "sampleCount": { "$ref": "#/$defs/count" },
        "resolvedSampleCount": { "$ref": "#/$defs/count" }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail", "claimId"],
      "properties": {
        "kind": { "enum": ["checkerNotRun", "checkerFailed", "testsNotExecuted", "buildNotExecuted", "repositoryNotFullyRead", "claimNotCited", "duplicateClaimId"] },
        "detail": { "type": "string" },
        "claimId": { "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] }
      }
    },
    "validationRemoval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "id", "reason"],
      "properties": {
        "scope": { "enum": ["track", "participant", "relationship", "statement"] },
        "id": { "type": "string", "maxLength": 512 },
        "reason": { "type": "string", "maxLength": 4096 }
      }
    },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 512 },
    "nodeIds": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
    "trust": { "enum": ["unchecked", "derived", "checked"] },
    "side": { "enum": ["before", "after"] },
    "repositoryPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "line": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "terminal": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "terminalAt"], "properties": { "kind": { "const": "completed" }, "terminalAt": { "$ref": "#/$defs/timestamp" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "terminalAt", "limitationCount"], "properties": { "kind": { "const": "completedWithLimitations" }, "terminalAt": { "$ref": "#/$defs/timestamp" }, "limitationCount": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "terminalAt"], "properties": { "kind": { "const": "cancelled" }, "terminalAt": { "$ref": "#/$defs/timestamp" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "terminalAt", "failureCode"], "properties": { "kind": { "const": "failed" }, "terminalAt": { "$ref": "#/$defs/timestamp" }, "failureCode": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" } } }
      ]
    },
    "refName": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^refs/(?:heads|remotes)/[^\\u0000]+$" },
    "token": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "guid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "runId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "timestamp": { "type": "integer", "minimum": 0 }
  }
}
