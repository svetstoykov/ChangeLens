{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changelens.dev/contracts/engine-protocol/v1/comparison-refresh-remote-baseline.schema.json",
  "title": "ChangeLens remote-baseline refresh exchange",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result" },
    { "$ref": "https://changelens.dev/contracts/engine-protocol/v1/error-response.schema.json" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "action", "parameters"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "action": { "const": "comparisons.refreshRemoteBaseline" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "target"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^(?=.*\\S)[^\\u0000]+$"
            },
            "target": { "$ref": "#/$defs/remoteRefName" }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "requestId", "result"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "result" },
        "requestId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["remoteRevision"],
          "properties": {
            "remoteRevision": { "$ref": "#/$defs/revision" }
          }
        }
      }
    },
    "remoteRefName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^refs/remotes/[^\\u0000]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    }
  }
}
