{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changelens.dev/contracts/engine-protocol/v1/preference-color-theme.schema.json",
  "oneOf": [
    { "$ref": "#/$defs/getRequest" },
    { "$ref": "#/$defs/getResult" },
    { "$ref": "#/$defs/setRequest" },
    { "$ref": "https://changelens.dev/contracts/engine-protocol/v1/payload-free-result.schema.json" },
    { "$ref": "https://changelens.dev/contracts/engine-protocol/v1/error-response.schema.json" }
  ],
  "$defs": {
    "getRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "action"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "action": { "const": "preferences.getColorTheme" }
      }
    },
    "getResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "requestId", "result"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "result" },
        "requestId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["colorTheme"],
          "properties": {
            "colorTheme": { "enum": ["light", "dark", null] }
          }
        }
      }
    },
    "setRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "action", "parameters"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "action": { "const": "preferences.setColorTheme" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["colorTheme"],
          "properties": {
            "colorTheme": { "enum": ["light", "dark"] }
          }
        }
      }
    }
  }
}
