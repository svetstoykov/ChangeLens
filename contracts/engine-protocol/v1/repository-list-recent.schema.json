{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changelens.dev/contracts/engine-protocol/v1/repository-list-recent.schema.json",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result" },
    { "$ref": "https://changelens.dev/contracts/engine-protocol/v1/error-response.schema.json" }
  ],
  "$defs": {
    "repositoryId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "action"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "action": { "const": "repositories.listRecent" },
        "parameters": true
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "requestId", "result"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "result" },
        "requestId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lastRepositoryId", "repositories"],
          "properties": {
            "lastRepositoryId": {
              "oneOf": [{ "$ref": "#/$defs/repositoryId" }, { "type": "null" }]
            },
            "repositories": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repositoryId",
                  "name",
                  "canonicalPath",
                  "lastOpenedAtUnixMilliseconds",
                  "preferredTarget"
                ],
                "properties": {
                  "repositoryId": { "$ref": "#/$defs/repositoryId" },
                  "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
                  "canonicalPath": { "type": "string", "minLength": 1, "pattern": "\\S" },
                  "lastOpenedAtUnixMilliseconds": { "type": "integer", "minimum": 0 },
                  "preferredTarget": { "type": ["string", "null"], "pattern": "\\S" }
                }
              }
            }
          }
        }
      }
    }
  }
}
