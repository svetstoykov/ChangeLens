{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changelens.dev/contracts/engine-protocol/v1/repository-remove-recent.schema.json",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "https://changelens.dev/contracts/engine-protocol/v1/payload-free-result.schema.json" },
    { "$ref": "https://changelens.dev/contracts/engine-protocol/v1/error-response.schema.json" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "action", "parameters"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "action": { "const": "repositories.removeRecent" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositoryId"],
          "properties": {
            "repositoryId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        }
      }
    }
  }
}
