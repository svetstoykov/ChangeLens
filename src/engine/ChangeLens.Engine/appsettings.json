{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ChangeLens": {
    "Analysis": {
      "ModelCompletion": {
        "BaseUrl": "https://openrouter.ai/api/v1",
        "Model": "deepseek/deepseek-v4.1-flash-1017",
        "ApiKeyFile": "~/.config/changelens/secrets.env",
        "RequestTimeout": "00:15:00"
      },
      "EvidenceBinder": {
        "ContextWindowTokens": 170000,
        "CuratorOutputCharacters": 312000
      },
      "Review": {
        "Enabled": true,
        "MaximumOutputCharacters": 176000,
        "MaximumOutputTokens": 96000
      }
    }
  }
}
